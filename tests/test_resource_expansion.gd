extends "res://tests/test_resources.gd"

func _initialize() -> void:
	CardDB.load_all()
	var g=GameState.new(77);apply(g,0,"faction",{"id":"I01"});apply(g,0,"initial",{"id":g.hands[0].group[0]})
	check(g.phase=="setup_resource" and g.resource_candidates[0].size()==5 and g.resource_candidates[1].size()==5,"Five resource candidates per player after initial group")
	check(g.resource_candidates[0].all(func(id):return id not in g.resource_candidates[1]),"Candidate pools do not overlap")
	check(g.hands[0].resource.is_empty() and g.hands[0].plot.size()==2 and g.hands[1].plot.size()==2,"No resource or initiative compensation before selection")
	var groups=g.hands[0].group.duplicate();var plots=g.hands[0].plot.duplicate();var enemy=g.resource_candidates[1].duplicate()
	apply(g,0,"reroll_resource");apply(g,0,"reroll_resource")
	check(action(g,0,"reroll_resource").is_empty() and g.resource_rerolls[0]==2,"Independent resource reroll cap two")
	check(g.hands[0].group==groups and g.hands[0].plot==plots and g.resource_candidates[1]==enemy,"Resource reroll preserves other hands and opponent candidates")
	var pick=g.resource_candidates[0][0];apply(g,0,"initial_resource",{"id":pick})
	check(g.phase=="draw" and pick in g.hands[0].resource and g.hands[1].resource.size()==1 and g.decks.resource.size()==CardDB.ids("resource").size()-2,"Selection returns unused resources and starts initiative once")
	check(g.resource_candidates==[[],[]] and g.resource_rerolls[1]<=2,"All candidates accounted for, AI obeys limit")
	g=fresh();give(g,"E01");give(g,"E02")
	check(action(g,0,"research",{"deck":"resource"}).is_empty() and not action(g,0,"research",{"deck":"group"}).is_empty() and not action(g,0,"research",{"deck":"plot"}).is_empty(),"Full resource hand only blocks resource draw")
	for kind in ["group","plot","resource"]:
		g=fresh();apply(g,0,"research",{"deck":kind});check(g.hands[0][kind].size()==1 and not g.token("R0") and not g.auto_used,"Main phase draw costs root action for "+kind)
	g=fresh();put(g,"E11");put(g,"G023");apply(g,0,"resource",{"src":"E11","target":"G023"})
	check(g.stat("G023","gp")==g.stat("G023","p") and not g.token("E11") and g.token("G023"),"Satellite changes GP, charges resource only")
	g._complete_end();check(not g.nodes.G023.get("compute",false),"Satellite expires at turn end")
	g=fresh();put(g,"G043");put(g,"G023",1);put(g,"E12",1);apply(g,0,"attack",{"src":"G043","target":"G023","mode":"destroy"})
	check(action(g,1,"resource",{"src":"E12"}).is_empty(),"Decoy requires opponent support")
	g.battle.support_a=3;apply(g,1,"resource",{"src":"E12"});check(g.battle.support_a==0 and "E12" in g.scrap,"Decoy subtracts support with zero floor and scraps itself")
	g=fresh();put(g,"E13",1);put(g,"E07",1);put(g,"G043");put(g,"G023",1);apply(g,0,"attack",{"src":"G043","target":"G023","mode":"destroy"});apply(g,1,"resource",{"src":"E07"})
	check(g.choice.get("source","")=="E13" and g.hands[1].plot.is_empty(),"Museum trigger waits until amulet scrap settles")
	apply(g,1,"trigger",{"src":"E13"});check(g.hands[1].plot.size()==2 and g.phase=="battle","Museum grants two Plots during opponent turn then resumes battle")
	g=fresh();put(g,"E14");put(g,"G071");g.nodes.G071.devastated=true;g.nodes.G071.token=0
	check(not action(g,0,"rebuild",{"target":"G071","payers":["R0"]}).is_empty(),"Repair vehicle permits one action to rebuild huge place")
	g.nodes.E14.silenced=true;check(action(g,0,"rebuild",{"target":"G071","payers":["R0"]}).is_empty(),"Blocked repair vehicle cannot reduce reconstruction cost")
	g=fresh();put(g,"E15");put(g,"G043",1);apply(g,0,"attack",{"src":"R0","target":"G043","mode":"destroy"});g.battle.responder=0;apply(g,0,"resource",{"src":"E15"})
	check(g.battle.fixed_dice==[3,4] and "E15" in g.scrap,"Coin sets exact dice and scraps itself")
	g.battle.bonus_a=100;g._resolve_battle();check(g.last_battle.dice==[3,4],"Coin used in actual settlement")
	g=fresh();put(g,"G001");put(g,"E11",1);give(g,"P59");give(g,"P15",1);apply(g,0,"plot",{"id":"P59","target":"E11","payer":"G001"});apply(g,1,"counter")
	check(g.owner("E11")==1 and not g.token("G001") and "P59" in g.discards.plot,"Requisition counter preserves target, consumes action fee")
	g=fresh();put(g,"G001");put(g,"E11",1);give(g,"P59");apply(g,0,"plot",{"id":"P59","target":"E11","payer":"G001"})
	check("E11" in g.hands[0].resource and "E11" not in g.scrap and not g.nodes.has("E11"),"Requisition takes gadget to hand, no scrap trigger")
	g=fresh();put(g,"G020");put(g,"E06");put(g,"E15",1);give(g,"P60");apply(g,0,"plot",{"id":"P60","target":"E15","other":"E06","payer":"G020"})
	check(g.owner("E15")==0 and g.owner("E06")==1 and not g.token("E06") and g.captured.has("E06") and g.captured.has("E15") and g.scrap.is_empty(),"Technology exchange swaps resources, no ready action or scrap")
	g=fresh();put(g,"G020");put(g,"E05");put(g,"E06",1)
	for id in ["E01","E02","E03"]:give(g,id)
	give(g,"P60");apply(g,0,"plot",{"id":"P60","target":"E06","other":"E05","payer":"G020"})
	check(g.resource_hand_limit(0)==2 and g.resource_hand_limit(1)==3 and g.choice.get("kind","")=="e_limit","Exchange immediately updates both capacities and queues excess-hand choice")
	apply(g,0,"choose",{"id":"E01"});check(g.hands[0].resource.size()==2 and not g.resources.recoverable("E06"),"Exchange overflow resolves and received resource cannot recharge this turn")
	g=fresh();put(g,"G091");give(g,"G043");apply(g,0,"resource",{"src":"G091","fee":"G043"})
	check(g.hands[0].resource.size()==1 and "G043" in g.discards.group and not g.token("G091") and g.token("R0"),"South Africa uses own action and group hand card")
	g=fresh();put(g,"G042",1);put(g,"G020");put(g,"G001")
	check(g.attack_preview("G020","G042","control").defense==4 and g.attack_preview("G001","G042","control").defense==0,"Table edit: conditional science/space defense")
	check(g.card("G045").r==3 and g.card("G049").gp==0,"Table numeric edits preserved")
	print("RESOURCE EXPANSION: %d checks, %d failures"%[checks,failures.size()]);quit(0 if failures.is_empty() else 1)
